# ===== Telegram =====
# Токен бота из @BotFather
BOT_TOKEN=your_telegram_bot_token

# Telegram ID администратора (узнать можно через @userinfobot)
ADMIN_ID=123456789

# ===== Twitch =====
# Получить на https://dev.twitch.tv/console/apps
TWITCH_CLIENT_ID=your_twitch_client_id
TWITCH_CLIENT_SECRET=your_twitch_client_secret

# Для режима без домена укажи ТОЧНО http://localhost в Redirect URL приложения Twitch.
# После авторизации скопируй URL из адресной строки и отправь его боту.
OAUTH_REDIRECT_URI=http://localhost

# ===== Поведение =====
# Сколько секунд ждать, пока Twitch обработает клип
CLIP_WAIT_TIMEOUT=30
# Интервал опроса готовности клипа (сек)
CLIP_POLL_INTERVAL=5
# Размер вертикального видео
VIDEO_WIDTH=1080
VIDEO_HEIGHT=1920

# ===== Пути (переопределять не нужно в докере) =====
# DB_PATH=/opt/twitchclipbot/data/bot.sqlite3
